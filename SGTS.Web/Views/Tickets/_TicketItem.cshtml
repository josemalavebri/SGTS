<template id="ticketTemplate">
  <article class="card ticket-card shadow-sm mb-2 ticket-item border-0" data-ticket-id="">
    <div class="card-body p-3">

      <!-- CABECERA -->
      <div class="d-flex justify-content-between align-items-start mb-2">

        <div class="min-w-0 pe-2">

          <!-- IDENTIFICACIÓN -->
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-light text-dark border ticket-id"></span>
            <span class="badge status"></span>
          </div>

          <!-- TÍTULO -->
          <h5 class="ticket-title fs-6 fw-bold mb-0 text-dark text-truncate"></h5>

        </div>

        <!-- OPCIONES -->
        <div class="dropdown flex-shrink-0">

          <button type="button" class="btn btn-sm btn-icon btn-ghost-secondary rounded-circle" data-bs-toggle="dropdown"
                  aria-expanded="false" aria-label="Opciones del ticket">

            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>

          </button>

          <ul class="dropdown-menu dropdown-menu-end shadow-sm">

            <li>
              <a class="dropdown-item ticket-view-link" href="#">
                <i class="bi bi-eye me-2"></i>
                Ver detalles
              </a>
            </li>

            <li>
              <a class="dropdown-item ticket-edit-link" href="#">
                <i class="bi bi-pencil me-2"></i>
                Editar
              </a>
            </li>

          </ul>

        </div>

      </div>


      <!-- DESCRIPCIÓN -->
      <p class="ticket-description text-secondary small text-truncate-3 mb-3"></p>


      <!-- INFORMACIÓN PRINCIPAL -->
      <div class="ticket-metadata small">

        <!-- FILA PRINCIPAL -->
        <div class="d-flex align-items-center gap-4 mb-2">

          <!-- FECHA -->
          <div class="d-inline-flex align-items-center text-muted">
            <i class="bi bi-calendar3 me-2" aria-hidden="true"></i>
            <time class="ticket-date"></time>
          </div>

          <!-- CATEGORÍA -->
          <div class="d-inline-flex align-items-center text-muted">
            <i class="bi bi-folder me-2" aria-hidden="true"></i>
            <span class="ticket-category text-truncate"></span>
          </div>

        </div>


        <!-- FILA SECUNDARIA -->
        <div class="d-flex align-items-center gap-4">

          <!-- PRIORIDAD -->
          <div class="d-inline-flex align-items-center">
            <i class="bi bi-flag-fill me-2" aria-hidden="true"></i>
            <span class="ticket-priority"></span>
          </div>

          <!-- TÉCNICO -->
          <div class="d-inline-flex align-items-center text-muted">
            <i class="bi bi-person-check me-2" aria-hidden="true"></i>
            <span class="ticket-technician text-truncate"></span>
          </div>

        </div>

      </div>


      <!-- SEPARADOR -->
      <hr class="my-3 text-border-light" />


      <!-- PIE -->
      <div class="d-flex justify-content-between align-items-center gap-3">

        <!-- ACTUALIZACIÓN -->
        <small class="text-muted d-flex align-items-center gap-1 text-truncate">

          <i class="bi bi-clock-history flex-shrink-0" aria-hidden="true">
          </i>

          <span class="ticket-updated text-truncate"></span>

        </small>


        <!-- ACCIÓN -->
        <a asp-controller="Tickets" asp-action="TicketDetail"
           class="btn btn-sm btn-outline-primary ticket-view-btn d-inline-flex align-items-center gap-1 flex-shrink-0">

          <i class="bi bi-eye" aria-hidden="true"></i>

          <span>Ver ticket</span>

        </a>

      </div>

    </div>
  </article>
</template>