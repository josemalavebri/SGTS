@{
  ViewData["Title"] = "Crear Ticket";
}

@section Styles {
  <link rel="stylesheet" href="~/css/modules/tickets/tickets.css" />
  <link rel="stylesheet" href="~/css/pages/crear-tickets.css" />
}

<div id="app" class="create-ticket" data-page="createTicketPage">

  <!-- FORMULARIO -->
  <div class="card ticket-form shadow-sm">

    <div class="card-body p-4">

      <form id="ticketForm">

        <!-- TÍTULO -->
        <div class="mb-3">

          <label for="ticketTitle" class="form-label fw-semibold">
            Título
          </label>

          <input type="text" id="ticketTitle" name="Titulo" class="form-control"
                 placeholder="Describe brevemente tu problema o solicitud..." maxlength="150" />

          <div id="ticketTitleError" class="ticket-field-error text-danger small d-none"></div>

        </div>


        <!-- CATEGORÍA Y PRIORIDAD -->
        <div class="row g-3">

          <!-- CATEGORÍA -->
          <div class="col-md-6">

            <label for="ticketCategory" class="form-label fw-semibold">
              Categoría
            </label>

            <select id="ticketCategory" name="IdCategoria" class="form-select">
              <option value="">
                Selecciona una categoría
              </option>

              <option value="1">Sistema</option>
              <option value="2">Hardware</option>
              <option value="3">Software</option>
              <option value="4">Permisos</option>
            </select>

            <div id="ticketCategoryError" class="ticket-field-error text-danger small d-none"></div>

          </div>


          <!-- PRIORIDAD -->
          <div class="col-md-6">

            <label for="ticketPriority" class="form-label fw-semibold">
              Prioridad
            </label>

            <select id="ticketPriority" name="IdPrioridad" class="form-select">
              <option value="">
                Selecciona una prioridad
              </option>

              <option value="1">Baja</option>
              <option value="2">Media</option>
              <option value="3">Alta</option>
            </select>

            <div id="ticketPriorityError" class="ticket-field-error text-danger small d-none"></div>

          </div>

        </div>


        <!-- DESCRIPCIÓN -->
        <div class="mt-3">

          <label for="ticketDescription" class="form-label fw-semibold">
            Descripción
          </label>

          <textarea id="ticketDescription" name="Descripcion" class="form-control" rows="6"
                    placeholder="Describe detalladamente el problema o solicitud..." maxlength="2000"></textarea>

          <div class="form-text">
            Incluye toda la información que pueda ayudar al técnico a resolver tu solicitud.
          </div>

          <div id="ticketDescriptionError" class="ticket-field-error text-danger small d-none"></div>

        </div>


        <!-- ARCHIVO ADJUNTO -->
        <div class="mt-3">

          <label for="ticketAttachment" class="form-label fw-semibold">
            Archivo adjunto
            <span class="text-muted fw-normal">(opcional)</span>
          </label>

          <input type="file" id="ticketAttachment" name="Attachment" class="form-control" />

          <div class="form-text">
            Puedes adjuntar capturas de pantalla o archivos relacionados con el problema.
          </div>

          <div id="ticketAttachmentError" class="ticket-field-error text-danger small d-none"></div>

        </div>


        <!-- ACCIONES -->
        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

          <a asp-controller="Tickets" asp-action="Index" class="btn btn-light">
            Cancelar
          </a>

          <button type="submit" id="createTicketButton" class="btn btn-primary">
            <i class="bi bi-send me-1"></i>
            Crear ticket
          </button>

        </div>

      </form>

    </div>

  </div>

</div>