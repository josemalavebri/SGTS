<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>@ViewData["Title"] - SGTS</title>

  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/SGTS.Web.styles.css" asp-append-version="true" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/lib/dataTables/datatables.min.css" />

  @await RenderSectionAsync("Styles", required: false)
</head>

<body>

  <div class="d-flex min-vh-100">

    <!-- SIDEBAR -->
    <aside class="sidebar d-none d-md-block p-3">

      <!-- Identidad -->
      <div class="mb-4">
        <h5 class="text-white mb-0">
          <i class="bi bi-headset me-2"></i>Soporte
        </h5>
        <small class="text-secondary">Sistema de Tickets</small>
      </div>

      <!-- Navegación Principal -->
      <nav>
        <a href="/Tickets" class="nav-link active">
          <i class="bi bi-ticket-perforated me-2"></i>Mis Tickets
        </a>
      </nav>

      <!-- Navegación Secundaria -->
      <div class="border-top border-secondary mt-4 pt-4">
        <a href="#" class="nav-link">
          <i class="bi bi-person me-2"></i>Mi Perfil
        </a>
        <a href="#" class="nav-link">
          <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
        </a>
      </div>

    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="content flex-grow-1">

      <!-- Header -->
      <header class="page-header px-4 py-3">
        <div class="d-flex justify-content-between align-items-center">

          <div>
            <h4 class="mb-1">@ViewData["Title"]</h4>
            <small class="text-muted">Sistema de Gestión de Tickets</small>
          </div>

          <!-- Usuario -->
          <div class="d-flex align-items-center gap-2">
            <div class="text-end d-none d-sm-block">
              <div class="fw-semibold">Usuario</div>
              <small class="text-muted">Usuario</small>
            </div>
            <div class="user-avatar">US</div>
          </div>

        </div>
      </header>

      <!-- Contenido de la Página -->
      <div class="app-content">
        <div class="app-content-container p-4">
          @RenderBody()
        </div>
      </div>

    </main>

  </div>

  <!-- LOADER GLOBAL -->
  <div id="globalLoader"
       class="d-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 justify-content-center align-items-center"
       style="z-index: 9999;">
    <div class="spinner-border text-light" role="status">
      <span class="visually-hidden">Cargando...</span>
    </div>
  </div>

  <!-- SCRIPTS -->
  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/lib/dataTables/datatables.min.js"></script>
  <script src="~/lib/sweetAlert2/sweetalert2.all.min.js"></script>
  <script src="~/js/app/main.js" type="module" asp-append-version="true"></script>

  @await RenderSectionAsync("Scripts", required: false)

</body>

</html>