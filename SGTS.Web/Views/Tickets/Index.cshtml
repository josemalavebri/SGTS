@{
  ViewData["Title"] = "Mis Tickets";
}

@section Styles {
  <link rel="stylesheet" href="~/css/modules/tickets/tickets.css" />
  <link rel="stylesheet" href="~/css/pages/my-tickets.css" />
}

<div id="app" class="tickets-page" data-page="tickets">

  <!-- ENCABEZADO Y ACCIONES -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h5 class="mb-1">Todas mis solicitudes</h5>
      <small class="text-muted">Tickets encontrados</small>
    </div>

    <a asp-controller="Tickets" asp-action="CrearTickets" class="btn btn-primary">
      <i class="bi bi-plus-lg me-1"></i>
      Nuevo ticket
    </a>
  </div>

  <!-- FILTROS -->
  <div class="card filter-card shadow-sm mb-4">
    <div class="card-body">

      <div class="row g-3">

        <!-- Buscar -->
        <div class="col-lg-5">
          <label for="searchInput" class="form-label small fw-semibold">
            Buscar
          </label>

          <div class="input-group">
            <span class="input-group-text bg-white">
              <i class="bi bi-search"></i>
            </span>

            <input type="text" id="searchInput" class="form-control" placeholder="Buscar por título o descripción..." />
          </div>
        </div>

        <!-- Estado -->
        <div class="col-lg-2">
          <label for="statusFilter" class="form-label small fw-semibold">
            Estado
          </label>

          <select id="statusFilter" class="form-select">
            <option value="">Todos</option>
            <option value="1">Abierto</option>
            <option value="2">En proceso</option>
            <option value="3">Cerrado</option>
          </select>
        </div>

        <!-- Prioridad -->
        <div class="col-lg-2">
          <label for="priorityFilter" class="form-label small fw-semibold">
            Prioridad
          </label>

          <select id="priorityFilter" class="form-select">
            <option value="">Todas</option>
            <option value="1">Baja</option>
            <option value="2">Media</option>
            <option value="3">Alta</option>
          </select>
        </div>

        <!-- Categoría -->
        <div class="col-lg-2">
          <label for="categoryFilter" class="form-label small fw-semibold">
            Categoría
          </label>

          <select id="categoryFilter" class="form-select">
            <option value="">Todas las categorías</option>
          </select>
        </div>

        <!-- Reiniciar -->
        <div class="col-lg-1 d-flex align-items-end">
          <button type="button" id="resetFiltersButton" class="btn btn-outline-secondary w-100"
                  title="Reiniciar filtros">
            <i class="bi bi-arrow-counterclockwise"></i>
          </button>
        </div>

      </div>

    </div>
  </div>

  <!-- ORDENAMIENTO -->
  <div class="col-lg-2 mb-4">
    <label for="sortFilter" class="form-label small fw-semibold">
      Ordenar por
    </label>

    <select id="sortFilter" class="form-select">
      <option value="" selected>Ordenar por...</option>

      <option value="FechaCreacion_desc">
        Más recientes
      </option>

      <option value="FechaCreacion_asc">
        Más antiguos
      </option>

      <option value="Prioridad_desc">
        Mayor prioridad
      </option>

      <option value="Prioridad_asc">
        Menor prioridad
      </option>

      <option value="Titulo_asc">
        Título A-Z
      </option>

      <option value="Titulo_desc">
        Título Z-A
      </option>
    </select>
  </div>

  <!-- LISTA DE TICKETS -->
  <div id="ticketContainer" class="ticket-list row g-3">
  </div>

  <!-- PAGINACIÓN -->
  <div class="d-flex justify-content-between align-items-center mt-4 ticket-pagination">

    <small class="text-muted pagination-summary">
      No se encontraron tickets
    </small>

    <nav aria-label="Paginación de tickets">
      <ul class="pagination mb-0">
      </ul>
    </nav>

  </div>

</div>

<partial name="_TicketItem" />