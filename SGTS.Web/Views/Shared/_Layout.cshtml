@{
  var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
  var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

  string IsActive(string ctrl, string act) =>
      string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) &&
      string.Equals(currentAction, act, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - SGTS</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/SGTS.Web.styles.css" asp-append-version="true" />

  @await RenderSectionAsync("Styles", required: false)
</head>

<body>

  <div class="d-flex min-vh-100">

    <!-- SIDEBAR -->
    <aside class="sidebar d-none d-md-block p-3">

      <!-- Identidad -->
      <div class="mb-4 px-2">
        <h5 class="text-white mb-0 d-flex align-items-center gap-2">
          <i class="bi bi-headset"></i>
          <span>Soporte</span>
        </h5>
        <small class="text-secondary">Sistema de Tickets</small>
      </div>

      <!-- Navegación Principal -->
      <nav aria-label="Navegación principal">
        <a asp-controller="Tickets" asp-action="Index" class="nav-link @IsActive("Tickets", "Index")">
          <i class="bi bi-ticket-perforated me-2"></i>
          Mis Tickets
        </a>

        <a asp-controller="Tickets" asp-action="CrearTickets" class="nav-link @IsActive("Tickets", "CrearTickets")">
          <i class="bi bi-plus-circle me-2"></i>
          Crear Tickets
        </a>
      </nav>

      <!-- Navegación Secundaria -->
      <div class="border-top border-secondary mt-4 pt-4">
        <nav aria-label="Navegación de usuario">
          <a asp-controller="Account" asp-action="Profile" class="nav-link">
            <i class="bi bi-person me-2"></i>Mi Perfil
          </a>
          <a asp-controller="Account" asp-action="Logout" class="nav-link text-danger-hover">
            <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
          </a>
        </nav>
      </div>

    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="content flex-grow-1 d-flex flex-column">

      <!-- Header -->
      <header class="page-header px-4 py-3 bg-body border-bottom">
        <div class="d-flex justify-content-between align-items-center">

          <div>
            <h4 class="mb-0">@ViewData["Title"]</h4>
            <small class="text-muted">Sistema de Gestión de Tickets</small>
          </div>

          <!-- Usuario -->
          <div class="d-flex align-items-center gap-3">
            <div class="text-end d-none d-sm-block">
              <div class="fw-semibold lh-1">@User.Identity?.Name</div>
              <small class="text-muted">Usuario</small>
            </div>
            <div
              class="user-avatar rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
              style="width: 40px; height: 40px;">
              US
            </div>
          </div>

        </div>
      </header>

      <!-- Contenido de la Página -->
      <section class="app-content flex-grow-1 p-4">
        <div class="app-content-container">
          @RenderBody()
        </div>
      </section>

    </main>

  </div>

  <!-- LOADER GLOBAL -->
  <div id="globalLoader"
       class="d-none position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 justify-content-center align-items-center"
       style="z-index: 9999;" aria-hidden="true">
    <div class="spinner-border text-light" role="status">
      <span class="visually-hidden">Cargando...</span>
    </div>
  </div>

  <!-- SCRIPTS -->

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <!-- Bootstrap -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- MAIN -->

  <script src="~/js/app/main.js" type="module" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)

</body>

</html>