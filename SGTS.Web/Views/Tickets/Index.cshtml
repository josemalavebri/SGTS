@{
  ViewData["Title"] = "Mis Tickets";

}

@section Styles {
  <link rel="stylesheet" href="~/css/modules/tickets/tickets.css" />
  <link rel="stylesheet" href="~/css/pages/my-tickets.css" />
}

<div id="app" class="tickets-page" data-page="tickets">

  <!-- ENCABEZADO Y ACCIONES -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h5 class="mb-1">Todas mis solicitudes</h5>
      <small class="text-muted">12 tickets encontrados</small>
    </div>
    <button type="button" class="btn btn-primary" id="newTicketButton">
      <i class="bi bi-plus-lg me-1"></i>
      Nuevo ticket
    </button>
  </div>

  <!-- FILTROS -->
  <div class="card filter-card shadow-sm mb-4">
    <div class="card-body">
      <div class="row g-3">

        <!-- Buscar -->
        <div class="col-lg-5">
          <label for="searchInput" class="form-label small fw-semibold">Buscar</label>
          <div class="input-group">
            <span class="input-group-text bg-white">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" id="searchInput" class="form-control" placeholder="Buscar por título o descripción..." />
          </div>
        </div>

        <!-- Estado -->
        <div class="col-lg-2">
          <label for="statusFilter" class="form-label small fw-semibold">Estado</label>
          <select id="statusFilter" class="form-select">
            <option value="">Todos</option>
            <option value="Abierto">Abierto</option>
            <option value="En proceso">En proceso</option>
            <option value="Cerrado">Cerrado</option>
          </select>
        </div>

        <!-- Prioridad -->
        <div class="col-lg-2">
          <label for="priorityFilter" class="form-label small fw-semibold">Prioridad</label>
          <select id="priorityFilter" class="form-select">
            <option value="">Todas</option>
            <option value="Alta">Alta</option>
            <option value="Media">Media</option>
            <option value="Baja">Baja</option>
          </select>
        </div>

        <!-- Categoría -->
        <div class="col-lg-3">
          <label for="categoryFilter" class="form-label small fw-semibold">Categoría</label>
          <select id="categoryFilter" class="form-select">
            <option value="">Todas las categorías</option>
            <option value="Sistema">Sistema</option>
            <option value="Hardware">Hardware</option>
            <option value="Software">Software</option>
            <option value="Permisos">Permisos</option>
          </select>
        </div>

      </div>
    </div>
  </div>

  <!-- LISTA DE TICKETS -->
  <div id="ticketContainer" class="ticket-list">

    
  </div>

  <!-- PAGINACIÓN -->
  <div class="d-flex justify-content-between align-items-center mt-4 ticket-pagination">
    <small class="text-muted">Mostrando 1–4 de 12 tickets</small>

    <nav aria-label="Paginación de tickets">
      <ul class="pagination mb-0">
        <li class="page-item disabled">
          <a class="page-link" href="#" aria-label="Anterior">
            <i class="bi bi-chevron-left"></i>
          </a>
        </li>
        <li class="page-item active"><a class="page-link" href="#">1</a></li>
        <li class="page-item"><a class="page-link" href="#">2</a></li>
        <li class="page-item"><a class="page-link" href="#">3</a></li>
        <li class="page-item">
          <a class="page-link" href="#" aria-label="Siguiente">
            <i class="bi bi-chevron-right"></i>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</div>

<partial name="_TicketItem" />