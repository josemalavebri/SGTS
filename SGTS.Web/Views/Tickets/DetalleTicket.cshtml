@{
  ViewData["Title"] = "Detalle del Ticket";
}
<div id="app" class="ticket-detail-page" data-page="ticketsDetail">

  <div class="ticket-detail" data-ticket-id="@ViewBag.IdTicket">

    <!-- =====================================================
         CABECERA
         ===================================================== -->

    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

      <div>

        <div class="d-flex align-items-center gap-2 mb-2">

          <span id="ticketId" class="ticket-id">
          </span>

          <span id="ticketStatus" class="status">
          </span>

        </div>

        <h2 id="ticketTitle" class="ticket-title mb-0">
        </h2>

      </div>

      <a asp-controller="Tickets" asp-action="Index" class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Volver

      </a>

    </div>


    <!-- =====================================================
         CONTENIDO
         ===================================================== -->

    <div class="row g-4">


      <!-- =================================================
             INFORMACIÓN PRINCIPAL
             ================================================= -->

      <div class="col-lg-8">


        <!-- =============================================
                 DESCRIPCIÓN
                 ============================================= -->

        <div class="card border-0 shadow-sm rounded-3">

          <div class="card-body p-4">

            <h5 class="fw-semibold mb-3">
              Descripción
            </h5>

            <p id="ticketDescription" class="ticket-description mb-0">
            </p>

          </div>

        </div>


        <!-- =============================================
                 ARCHIVOS ADJUNTOS
                 ============================================= -->

        <!--
                Los archivos se mantienen fuera de la carga
                dinámica por ahora.
            -->

        <div class="card border-0 shadow-sm rounded-3 mt-4">

          <div class="card-body p-4">

            <h5 class="fw-semibold mb-3">
              Archivos adjuntos
            </h5>

            <div class="ticket-attachment
              d-flex
              justify-content-between
              align-items-center
              gap-3
              border
              rounded-2
              p-3">

              <div class="d-flex align-items-center gap-3">

                <div class="ticket-attachment__icon
                  d-flex
                  align-items-center
                  justify-content-center">

                  <i class="bi bi-file-earmark"></i>

                </div>

                <div>

                  <div class="ticket-attachment__name fw-semibold">
                    Próximamente
                  </div>

                  <small class="ticket-attachment__size">
                    Los archivos adjuntos serán implementados posteriormente.
                  </small>

                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- =============================================
                 SEGUIMIENTO
                 ============================================= -->

        <div class="card border-0 shadow-sm rounded-3 mt-4">

          <div class="card-body p-4">

            <h5 class="fw-semibold mb-4">
              Seguimiento
            </h5>

            <div id="ticketTimeline" class="ticket-timeline">

              <!--
                            Las actividades serán generadas
                            dinámicamente mediante JavaScript.
                        -->

            </div>

          </div>

        </div>

      </div>


      <!-- =================================================
             INFORMACIÓN SECUNDARIA
             ================================================= -->

      <div class="col-lg-4">


        <!-- =============================================
                 INFORMACIÓN DEL TICKET
                 ============================================= -->

        <div class="card border-0 shadow-sm rounded-3">

          <div class="card-body p-4">

            <h5 class="fw-semibold mb-4">
              Información del ticket
            </h5>

            <div class="d-flex flex-column gap-3">


              <!-- CATEGORÍA -->

              <div>

                <div class="small text-muted mb-1">
                  Categoría
                </div>

                <div id="ticketCategory" class="fw-medium">

                  <i class="bi bi-folder me-1"></i>

                </div>

              </div>


              <!-- PRIORIDAD -->

              <div>

                <div class="small text-muted mb-1">
                  Prioridad
                </div>

                <div id="ticketPriority" class="fw-medium">

                  <i class="bi bi-flag-fill me-1"></i>

                </div>

              </div>


              <!-- ESTADO -->

              <div>

                <div class="small text-muted mb-1">
                  Estado
                </div>

                <span id="ticketInfoStatus" class="status">

                </span>

              </div>


              <!-- FECHA DE CREACIÓN -->

              <div>

                <div class="small text-muted mb-1">
                  Fecha de creación
                </div>

                <div id="ticketCreatedAt" class="fw-medium">
                </div>

              </div>


              <!-- ÚLTIMA ACTUALIZACIÓN -->

              <div>

                <div class="small text-muted mb-1">
                  Última actualización
                </div>

                <div id="ticketUpdatedAt" class="fw-medium">
                </div>

              </div>


              <!-- TÉCNICO ASIGNADO -->

              <div>

                <div class="small text-muted mb-1">
                  Técnico asignado
                </div>

                <div id="ticketTechnician" class="fw-medium">
                </div>

              </div>

            </div>

          </div>

        </div>


        <!-- =============================================
                 SOLICITANTE
                 ============================================= -->

        <div class="card border-0 shadow-sm rounded-3 mt-4">

          <div class="card-body p-4">

            <h5 class="fw-semibold mb-4">
              Solicitante
            </h5>

            <div class="d-flex align-items-center gap-3">


              <!-- AVATAR -->

              <div id="requesterAvatar" class="ticket-requester__avatar
                d-flex
                align-items-center
                justify-content-center">
              </div>


              <!-- INFORMACIÓN -->

              <div>

                <div id="requesterName" class="fw-semibold">
                </div>

                <small class="text-muted">
                  Usuario
                </small>

              </div>

            </div>

          </div>

        </div>


        <!-- =============================================
                 ACCIONES
                 ============================================= -->

        <div class="d-grid gap-2 mt-4">

          <button type="button" id="btnEditTicket" class="btn btn-outline-primary">

            <i class="bi bi-pencil me-1"></i>

            Editar ticket

          </button>


          <button type="button" id="btnCancelTicket" class="btn btn-outline-danger">

            <i class="bi bi-x-circle me-1"></i>

            Cancelar ticket

          </button>

        </div>

      </div>

    </div>

  </div>
</div>


@section Styles {

  <link rel="stylesheet" href="~/css/pages/ticket-detail.css" />

}
